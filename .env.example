# DocuMind — Environment Variables
# Copy this file to .env and fill in values as needed.
# .env is gitignored and must never be committed.

# ─── Ingestion ───────────────────────────────────────────────────────────────
# Default corpus directory (relative to project root)
# DOCUMIND_CORPUS_DIR=data/corpus

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
# DOCUMIND_LOG_LEVEL=INFO
