# DocuMind — Environment Variables
# Copy this file to .env and fill in values as needed.
# .env is gitignored and must never be committed.

# ─── Ingestion ───────────────────────────────────────────────────────────────
# Default corpus directory (relative to project root)
# DOCUMIND_CORPUS_DIR=data/corpus

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
# DOCUMIND_LOG_LEVEL=INFO

# ─── Chunking ─────────────────────────────────────────────────────────────────
# DOCUMIND_CHUNK_SIZE=512
# DOCUMIND_CHUNK_OVERLAP=50

# ─── Embeddings (Phase 3) ─────────────────────────────────────────────────────
# Local HuggingFace model for chunk embedding
# DOCUMIND_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Output vector dimension (must match the model and the DB schema)
# DOCUMIND_EMBEDDING_DIMENSION=384
# Chunks per encoding batch (increase for GPU, reduce for low-RAM CPU)
# DOCUMIND_EMBEDDING_BATCH_SIZE=64

# ─── Database (Phase 3) ───────────────────────────────────────────────────────
# Async PostgreSQL URL — matches Docker Compose defaults
# DOCUMIND_DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5434/documind
